# Application
APP_NAME=Artysy
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://artysy_user:artysy_password@localhost:5432/artysy_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase (optional — required if frontend uses Supabase tokens)
# Public Supabase URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=
# Service role key — MUST remain server-side only. Used for signed urls / admin operations.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: S3 / object storage for product images (add later)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1
